// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  cash
  card
  checking
  savings
  investment
  wallet
  other
}

model User {
  id        String   @id
  email     String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  settings      UserSettings?
  guide            UserGuide?
  budgetEntries    BudgetEntry[]
  budgetExchanges  BudgetExchange[]

  @@map("users")
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  currency       String
  initialBalance Decimal     @db.Decimal(10, 2)
  /// Position in the user's own order (dashboard). NULL = never ordered: shown after the ordered ones, by name.
  sortOrder      Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  transactions   Transaction[]
  @@map("accounts")
}

enum CategoryType {
  income
  expense
}

model Category {
  id           String       @id @default(cuid())
  userId       String?      // null = default category
  name         String
  color        String       // hex color
  type         CategoryType @default(expense)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user          User?         @relation(fields: [userId], references: [id])
  transactions  Transaction[]
  budgetEntries BudgetEntry[]

  @@map("categories")
}

enum TransactionType {
  income
  expense
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?   // nullable for transfers/incomes
  type        TransactionType
  amount      Decimal   @db.Decimal(10, 2)
  description String
  date        DateTime
  transferId  String?   // used to link both sides of a transfer
  isRecurring Boolean?  @default(false)
  frequency   String?
  endsAt      DateTime?
  recurringId String?   // used to link recurring occurrences
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  account     Account   @relation(fields: [accountId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])

  @@map("transactions")
}


// Per-user preferences. baseCurrency is the home currency (All converts into it).
model UserSettings {
  userId          String   @id
  baseCurrency    String   @db.VarChar(8)
  /// "home" = open the one-currency dashboard; "all" = open All (converted to baseCurrency).
  openDashboardOn String   @default("home") @db.VarChar(8)
  /// "light" | "dark" | "system". New users start on light.
  theme           String   @default("light") @db.VarChar(8)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@map("user_settings")
}

// Latest daily FX snapshot per home currency, filled from a public feed by the server service.
model ExchangeRateSnapshot {
  base      String   @db.VarChar(8)
  fetchedOn DateTime @db.Date
  asOf      DateTime @db.Date
  rates     Json
  fetchedAt DateTime @default(now())

  @@id([base, fetchedOn])
  @@map("exchange_rate_snapshots")
}

// Expected amount for one category in one month and currency. Missing or zero = not planned.
model BudgetEntry {
  id             String   @id @default(cuid())
  userId         String
  yearMonth      String   @db.VarChar(7)
  currency       String   @db.VarChar(8)
  categoryId     String
  expectedAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, yearMonth, currency, categoryId])
  @@index([userId, yearMonth, currency])
  @@map("budget_entries")
}

// Expected amounts that arrive from / leave to another currency (not a category).
// Zero or missing on a side means that side is unplanned.
model BudgetExchange {
  id          String   @id @default(cuid())
  userId      String
  yearMonth   String   @db.VarChar(7)
  currency    String   @db.VarChar(8)
  expectedIn  Decimal  @db.Decimal(10, 2)
  expectedOut Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth, currency])
  @@map("budget_exchanges")
}

// Onboarding guide: remembers which tips the user has dismissed (e.g. "checklist", "multi-currency")
model UserGuide {
  userId    String   @id
  dismissed Json     // string[] of dismissed tip ids
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@map("user_guide")
}
