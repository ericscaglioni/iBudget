{
  "name": "ibudget",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma migrate deploy && prisma generate && node scripts/adopt-db-password-from-env.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "tsc": "tsc --noEmit",
    "init:users": "tsx scripts/initialize-existing-users.ts",
    "db:seed": "prisma db seed",
    "db:migration_new": "prisma migrate dev --create-only",
    "db:migration_apply": "npx prisma migrate dev",
    "db:migration_status": "prisma migrate status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clerk/backend": "^1.30.0",
    "@clerk/nextjs": "^6.15.0",
    "@fontsource/inter": "^5.2.5",
    "@headlessui/react": "^2.2.1",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.6.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "mysql2": "^3.15.2",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.3",
    "svix": "^1.64.1",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^27.0.0",
    "postcss": "8.5.32",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
